<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target .NET 10 for Windows with WinForms support -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Preserve existing assembly and namespace settings -->
    <AssemblyName>GageTracker</AssemblyName>
    <RootNamespace>GageCalibrationTracker</RootNamespace>
    <StartupObject>GageCalibrationTracker.My.MyApplication</StartupObject>
    <OutputType>WinExe</OutputType>

    <!-- Keep deterministic builds and disable auto assembly info generation (keeps AssemblyInfo.vb) -->
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Application manifest and icon -->
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>
    <ApplicationIcon>GTLogo.ico</ApplicationIcon>

        <!-- Signing / manifest settings preserved (temporary: disable assembly and manifest signing for SDK build)
          To re-enable strong-name signing for net10 builds, use PublicSign or sign during CI with appropriate tooling. -->
        <SignAssembly>false</SignAssembly>
        <AssemblyOriginatorKeyFile>GageCalibrationTracker_TemporaryKey.pfx</AssemblyOriginatorKeyFile>
        <SignManifests>false</SignManifests>
           <GenerateManifests>true</GenerateManifests>
           <ManifestCertificateThumbprint>8E1B94B63ED4D59A9E9A198E9913676C74B5D804</ManifestCertificateThumbprint>
           <!-- Suppress WinForms designer serialization analyzer error for legacy designer fields (WFO1000).
             Recommended follow-up: open affected forms in Visual Studio and resave to regenerate designer code. -->
           <NoWarn>$(NoWarn);WFO1000</NoWarn>
           <!-- Preserve VB "Application Framework" behaviour (My.Application, Startup events, etc.) -->
           <EnableApplicationFramework>true</EnableApplicationFramework>
           <MyType>WindowsForms</MyType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>GageTracker.xml</DocumentationFile>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>GageTracker.xml</DocumentationFile>
  </PropertyGroup>

  <!-- Keep designer generators for special files (datasets, application, settings) -->
  <ItemGroup>
    <None Include="Datasets\GTDatabaseDataSet.xsd">
      <Generator>MSDataSetGenerator</Generator>
      <LastGenOutput>GTDatabaseDataSet.Designer.vb</LastGenOutput>
      <SubType>Designer</SubType>
    </None>
    <None Include="Datasets\GTDatabaseDataSet.xsc">
      <DependentUpon>GTDatabaseDataSet.xsd</DependentUpon>
    </None>
    <None Include="Datasets\GTDatabaseDataSet.xss">
      <DependentUpon>GTDatabaseDataSet.xsd</DependentUpon>
    </None>

    <None Include="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
    <None Include="My Project\app.manifest" />
    <None Include="App.config" />
    <None Include="GageCalibrationTracker_TemporaryKey.pfx" />
  </ItemGroup>

  <!-- Add VB default Imports so designer files resolve WinForms and common types -->
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Linq" />
    <Import Include="System.Xml.Linq" />
    <Import Include="System.Threading.Tasks" />
  </ItemGroup>

  <!-- Bring in compatibility APIs (OLE DB and other Windows-only APIs) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.0" />
  </ItemGroup>

  <!-- Keep icons/content copied to output -->
  <ItemGroup>
    <None Include="GTLogo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="quality_management_software_icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>



  <!-- Preserve Publish / ClickOnce related metadata (may be unused by SDK but kept for reference) -->
  <PropertyGroup>
    <PublishUrl>publish\</PublishUrl>
    <InstallUrl>https://alexfare.com/programs/gagetracker/latest/</InstallUrl>
    <UpdateUrl>https://alexfare.com/programs/gagetracker/latest/</UpdateUrl>
    <SupportUrl>https://github.com/alexfare/GageTracker</SupportUrl>
    <ErrorReportUrl>https://github.com/alexfare/GageTracker</ErrorReportUrl>
    <ProductName>GageTracker</ProductName>
    <PublisherName>Alex Fare</PublisherName>
  </PropertyGroup>

</Project>